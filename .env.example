# Токен бота от @BotFather
BOT_TOKEN=

# Приложение Яндекса для входа по коду (oauth.yandex.ru):
# Callback URI: https://oauth.yandex.ru/verification_code
# Права: cloud_api:disk.read и cloud_api:disk.write
# Если оставить пустыми, вход по коду отключён и диск подключается через /settoken
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Ключ шифрования токенов. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Сколько файлов в минуту может отправить один человек
RATE_LIMIT_PER_MIN=10
